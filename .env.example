# ==========================================
# Pricewise AI - Environment Variables
# ==========================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/pricewise_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Server Port
PORT=8080

# Price Tracking Scheduler Configuration
# Interval in milliseconds (default: 60000 = 60s for development, 3600000 = 1 hour for production)
TRACKING_INTERVAL=60000
TRACKING_ENABLED=true

# Amazon PA-API 5.0 (Product Advertising API) Credentials (Optional)
# Get credentials from https://affiliate-program.amazon.in/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_REGION=in

# Flipkart Affiliate API Credentials (Optional)
# Get credentials from https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Croma Partner API Key (Optional)
CROMA_API_KEY=

# Email Notification Service (SMTP) Credentials (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional AI / LLM Key for price trend analysis
AI_API_KEY=
