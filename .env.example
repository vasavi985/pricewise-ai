# ==========================================
# Pricewise AI - Environment Variables
# ==========================================

# Firebase Cloud Firestore Configuration (Default Database)
# Option A: Path to downloaded Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# Option B: Direct Service Account credentials (recommended for cloud deployments / CI)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: Escape newlines as \n in the private key string or use double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Backend Server Port
PORT=8080

# Price Tracking Scheduler Configuration
# Interval in milliseconds (default: 60000 = 60s for development, 3600000 = 1 hour for production)
TRACKING_INTERVAL=60000
TRACKING_ENABLED=true

# Amazon PA-API 5.0 (Product Advertising API) Credentials (Optional)
# Get credentials from https://affiliate-program.amazon.in/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_REGION=in

# Flipkart Affiliate API Credentials (Optional)
# Get credentials from https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Croma Partner API Key (Optional)
CROMA_API_KEY=

# Email Notification Service (SMTP) Credentials (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional AI / LLM Key for price trend analysis
AI_API_KEY=
